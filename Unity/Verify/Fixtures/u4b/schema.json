{
  "version": 1,
  "namespace": "MyGame.Data",
  "enums": {
    "Grade": ["common", "rare", "epic"],
    "Element": ["fire", "ice"]
  },
  "tables": [
    { "name": "item", "columns": [
      { "name": "id",     "type": "string" },
      { "name": "name",   "type": "string", "loc": true },
      { "name": "atk",    "type": "string", "default": "0" },
      { "name": "price",  "type": "float",  "min": 0, "default": 0 },
      { "name": "usable", "type": "bool",   "default": false },
      { "name": "grade",  "type": "enum",   "enum": "Grade", "default": "common" },
      { "name": "tags",   "type": "list<string>", "default": [] } ] },
    { "name": "monster", "columns": [
      { "name": "id",      "type": "string" },
      { "name": "name",    "type": "string", "loc": true },
      { "name": "hp",      "type": "int",    "min": 1, "max": 999999 },
      { "name": "element", "type": "enum",   "enum": "Element", "default": "fire" },
      { "name": "icon",    "type": "asset",  "kind": "image", "default": "" },
      { "name": "sfx",     "type": "list<asset>", "kind": "audio", "default": [] } ] },
    { "name": "drop", "columns": [
      { "name": "id",         "type": "string" },
      { "name": "monster_id", "type": "ref",   "ref": "monster" },
      { "name": "item_id",    "type": "ref",   "ref": "item" },
      { "name": "rate",       "type": "float", "min": 0, "max": 1 },
      { "name": "counts",     "type": "list<int>", "default": [1] } ] }
  ]
}
